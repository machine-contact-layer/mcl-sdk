# Firmware build tree. build-firmware.ps1 stages the canonical protocol sources
# into it and deletes them afterwards; nothing here is a source of record. The
# image's SHA-256 is recorded in the evidence README instead, which ties a run
# to exact inputs without carrying a binary that will be stale by the next one.
hardware/esp32-dual-peer/build/

# Same rule for the autonomous node: the build tree is not a source of record.
# build-manifest.txt is regenerated per build and names absolute local paths.
hardware/dfr1154-autonomous-node/build/
hardware/dfr1154-autonomous-node/build-manifest.txt
hardware/dfr1154-autonomous-node/spike-ble-memory/build-manifest.txt

# The Android bench builds the same way: build-apk.ps1 stages the canonical
# sources, hashes them into build-manifest.txt with absolute local paths, and
# writes the APK under build/. Neither is a source of record; the APK SHA-256
# goes in the evidence that cites it.
hardware/android-bench/build/
hardware/android-bench/build-manifest.txt

# .NET build output for the host harness
tools/dual-transport-peer/bin/
tools/dual-transport-peer/obj/

# CMake build trees
build/
build-*/
out/
Testing/
__pycache__/
