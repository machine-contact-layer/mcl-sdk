<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host harness for the MCL dual-transport migration experiment.

    C# is used only because Windows exposes Bluetooth LE scanning and GATT
    exclusively through WinRT. All protocol work (framing, fragmentation,
    the contact state machine and every handoff control) is done by
    mcl_dual_host.dll, built from the canonical C sources; see
    tools/dual_host_shim.c.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>mcl_dual_transport_peer</AssemblyName>
    <RootNamespace>Mcl.Sdk.DualTransport</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The harness owns the board's serial port: it writes the board-side evidence
    log and arms the deliberate-drop command at an exact point in the sequence,
    and two processes cannot both hold the port.
  -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
  </ItemGroup>

</Project>
